body {
    text-align: center;
    font-family: Arial, sans-serif;
    background: #e8f5e9;
    color: #2e7d32;
}

h1 {
    font-size: 40px;
}

button {
    padding: 10px 20px;
    font-size: 18px;
    background: #4caf50;
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 5px;
}

button:hover {
    opacity: 0.9;
}
